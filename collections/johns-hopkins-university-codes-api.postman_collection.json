        {
          "id": "5d6e611e-9658-417b-a7f9-deeeae68a1c7",
          "name": "List departments for a school",
          "request": {
            "name": "List departments for a school",
            "description": {
              "content": "Returns the list of all departments for the specified school. School names must be typed exactly as returned by /classes/codes/schools, with spaces encoded as %20. Department names containing a forward slash must encode it as an underscore (_).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "classes",
                "codes",
                "departments",
                ":school"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) API key issued after registration at https://sis.jhu.edu/api/help."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "school",
                  "description": "(Required) Exact school name."
                }
              ]
            },
            "header": [
